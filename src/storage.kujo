# RunLedger :: storage
#
# Local, file-backed persistence. Each run is one pretty-printed JSON file under
# <ledger_dir>/runs/<id>.json. There is no database and no global state: every
# function takes the ledger directory explicitly so callers stay in control of
# where the ledger lives (default ./.runledger, overridable via CLI/env).

from src.util import slug, pad_int, truthy
from src.record import empty_usage, empty_cost, empty_correlation

# Path to the directory holding individual run files.
export func runs_dir(ledger_dir) {
    return join_path(ledger_dir, "runs")
}

# Per-record locks serialize CLI read-modify-write transactions. Lock files are
# deliberately separate from run JSON so listings and direct receipt readers
# keep their existing contract.
export func locks_dir(ledger_dir) {
    return join_path(ledger_dir, "locks")
}

# Full path to a single run's JSON file.
export func run_path(ledger_dir, id) {
    return join_path(runs_dir(ledger_dir), id + ".json")
}

# True when a caller-supplied id is safe to map to exactly one file under
# <ledger>/runs. Keep identifiers printable and portable as well as path-safe:
# a malformed id must not inject new lines into CLI diagnostics or lock names.
export func is_safe_run_id(id) {
    if type(id) != "string" || id == "" {
        return false
    }
    if id == "." || id == ".." {
        return false
    }
    mut i := 0
    while i < len(id) {
        ch := substring(id, i, i + 1)
        if index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.", ch) < 0 {
            return false
        }
        i = i + 1
    }
    return true
}

# Create a directory tree one segment at a time.
func ensure_dir_tree(path) {
    if path == "" || path == "." {
        return
    }
    parts := split(path, "/")
    mut cur := ""
    if starts_with(path, "/") {
        cur = "/"
    }
    mut i := 0
    while i < len(parts) {
        part := parts[i]
        if part != "" && part != "." {
            if cur == "/" {
                cur = "/" + part
            } else if cur == "" {
                cur = part
            } else {
                cur = cur + "/" + part
            }
            if path_is_dir(cur) == false {
                create_dir(cur)
            }
        }
        i = i + 1
    }
}

# Parent directory of a path.
func parent_dir(path) {
    mut i := len(path) - 1
    while i >= 0 {
        if substring(path, i, i + 1) == "/" {
            if i == 0 {
                return "/"
            }
            return substring(path, 0, i)
        }
        i = i - 1
    }
    return "."
}

# Write `content` to `path` atomically with the runtime primitive. The runtime
# uses a unique sibling file, syncs it, and promotes it atomically, avoiding
# collisions between writes that happen in the same clock tick.
export func write_atomic_text(path, content) {
    try {
        ensure_dir_tree(parent_dir(path))
        write_file_atomic(path, content, true)
        return {"ok": path}
    } except error {
        return {"error": "cannot write file: " + path + ": " + "${error}"}
    }
}

# Create the ledger directory tree if it does not already exist. Safe to call
# repeatedly. Returns the runs directory path.
export func ensure_ledger(ledger_dir) {
    ensure_dir_tree(ledger_dir)
    rd := runs_dir(ledger_dir)
    ensure_dir_tree(rd)
    return rd
}

func record_lock_path(ledger_dir, id) {
    return join_path(locks_dir(ledger_dir), id + ".lock")
}

func record_lock_timeout_ms() {
    raw := env_or("RUNLEDGER_LOCK_TIMEOUT_MS", "10000")
    mut value := 10000
    try {
        value = parse_int(trim(raw))
    } except parse_error {
        return 10000
    }
    if value < 10 || value > 60000 {
        return 10000
    }
    return value
}

# Acquire one record lock with bounded waiting. The atomic no-overwrite create
# is the ownership decision: only one process can receive the token. A lock
# left by an interrupted process is never guessed stale; the error names the
# exact file so an operator can inspect/remove it after confirming no writer is
# active.
export func acquire_record_lock(ledger_dir, id) {
    if is_safe_run_id(id) == false {
        return {"error": "invalid run id (use letters, digits, hyphen, underscore, or period)"}
    }
    try {
        ensure_dir_tree(locks_dir(ledger_dir))
    } except directory_error {
        return {"error": "cannot create ledger locks directory: " + locks_dir(ledger_dir)}
    }
    path := record_lock_path(ledger_dir, id)
    token := id + "-" + to_string(current_timestamp()) + "-" + to_string(random_int(100000, 999999))
    started_at := current_timestamp()
    timeout_ms := record_lock_timeout_ms()
    while current_timestamp() - started_at <= timeout_ms {
        payload := to_json({
            "token": token,
            "run_id": id,
            "created_at": now_utc()
        })
        try {
            write_file_atomic(path, payload, false)
            return {"ok": true, "path": path, "token": token}
        } except lock_error {
            sleep(10)
        }
    }
    return {
        "error": "run is busy: " + id + "; retry after the active writer finishes. If no writer is active, inspect and remove stale lock: " + path
    }
}

# Release only the lock carrying the caller's token. Ownership loss is surfaced
# instead of deleting another process's lock.
export func release_record_lock(lock) {
    path := lock["path"]
    token := lock["token"]
    if file_exists(path) == false {
        return {"ok": true}
    }
    mut raw := ""
    mut payload := null
    try {
        raw = read_file(path)
    } except read_error {
        return {"error": "cannot verify record lock ownership: " + path}
    }
    try {
        payload = parse_json(raw)
    } except parse_error {
        return {"error": "cannot verify record lock ownership: " + path}
    }
    if type(payload) != "dict" || has_key(payload, "token") == 0 || payload["token"] != token {
        return {"error": "record lock ownership changed before release: " + path}
    }
    try {
        delete_file(path)
    } except delete_error {
        return {"error": "cannot release record lock: " + path}
    }
    return {"ok": true}
}

func release_or_result(lock, result) {
    release_res := release_record_lock(lock)
    if has_key(release_res, "error") == 1 {
        return {"error": "record lock cleanup failed: " + release_res["error"]}
    }
    return result
}

# Execute a complete record mutation under one lock. The record is loaded only
# after ownership is acquired, so each updater sees the prior committed write.
# `updater` returns {"record": record} or an {"error": ...} result.
export func update_record(ledger_dir, id, updater) {
    lock := acquire_record_lock(ledger_dir, id)
    if has_key(lock, "error") == 1 {
        return lock
    }

    rec := load(ledger_dir, id)
    if type(rec) == "null" {
        return release_or_result(lock, {"error": "no such run: " + id})
    }
    if type(rec) == "dict" && has_key(rec, "error") == 1 {
        return release_or_result(lock, rec)
    }

    mut result := null
    try {
        result = updater(rec)
    } except update_error {
        return release_or_result(lock, {"error": "record update failed: " + id + ": " + "${update_error}"})
    }
    if type(result) != "dict" {
        return release_or_result(lock, {"error": "record updater returned " + type(result) + " for run: " + id})
    }
    if has_key(result, "error") == 1 {
        return release_or_result(lock, result)
    }
    if has_key(result, "record") == 0 || type(result["record"]) != "dict" {
        return release_or_result(lock, {"error": "record updater returned no record for run: " + id})
    }

    save_res := save_update(ledger_dir, result["record"])
    if has_key(save_res, "error") == 1 {
        return release_or_result(lock, save_res)
    }
    release_res := release_record_lock(lock)
    if has_key(release_res, "error") == 1 {
        return {
            "error": "record update committed, but lock cleanup failed: " + release_res["error"] + "; inspect the receipt before retrying",
            "committed": true
        }
    }
    result["ok"] := save_res["ok"]
    return result
}

# True if a run with this id already exists on disk.
export func exists(ledger_dir, id) {
    if is_safe_run_id(id) == false {
        return false
    }
    return file_exists(run_path(ledger_dir, id))
}

# Mint a stable, human-readable id of the form
#   YYYY-MM-DD-<model-slug>-<task-slug>-NNN
# where NNN is the next free 3-digit sequence for that exact prefix. This keeps
# ids sortable, readable, and collision-free within a ledger.
export func generate_id(ledger_dir, model, task_name) {
    prefix := format_date(now_unix(), "YYYY-MM-DD") + "-" + slug(model) + "-" + slug(task_name)
    mut seq := 1
    while seq < 1000 {
        candidate := prefix + "-" + pad_int(seq, 3)
        if exists(ledger_dir, candidate) == false {
            return candidate
        }
        seq = seq + 1
    }
    # Extremely unlikely fallback: append a timestamp to stay unique.
    return prefix + "-" + to_string(now())
}

# Persist a brand-new record. Refuses to clobber an existing file so runs are
# never silently overwritten.
export func save_new(ledger_dir, record) {
    if is_safe_run_id(record["id"]) == false {
        return {"error": "invalid run id (use letters, digits, hyphen, underscore, or period)"}
    }
    try {
        ensure_ledger(ledger_dir)
    } except directory_error {
        return {"error": "cannot create ledger runs directory: " + runs_dir(ledger_dir)}
    }
    path := run_path(ledger_dir, record["id"])
    if file_exists(path) {
        return {"error": "run already exists: " + record["id"], "conflict": true}
    }
    # The no-overwrite runtime operation closes the check/write race: if
    # another process creates this run after the check above, this write fails
    # instead of replacing that receipt.
    try {
        write_file_atomic(path, to_json_pretty(record), false)
    } except error {
        if file_exists(path) {
            return {"error": "run already exists: " + record["id"], "conflict": true}
        }
        return {"error": "cannot write run file: " + path + ": " + "${error}"}
    }
    return {"ok": path}
}

# Low-level persistence for an already-owned record (replaces in place).
# Read-modify-write callers must use update_record so the load and save share
# one ownership boundary.
export func save_update(ledger_dir, record) {
    if is_safe_run_id(record["id"]) == false {
        return {"error": "invalid run id (use letters, digits, hyphen, underscore, or period)"}
    }
    try {
        ensure_ledger(ledger_dir)
    } except directory_error {
        return {"error": "cannot create ledger runs directory: " + runs_dir(ledger_dir)}
    }
    path := run_path(ledger_dir, record["id"])
    res := write_atomic_text(path, to_json_pretty(record))
    if has_key(res, "error") == 1 {
        return res
    }
    return {"ok": path}
}

# Load one record by id. Returns null if it does not exist, or an
# {"error": ...} dict if the file is present but unreadable/corrupt.
export func load(ledger_dir, id) {
    if is_safe_run_id(id) == false {
        return {"error": "invalid run id (use letters, digits, hyphen, underscore, or period)"}
    }
    path := run_path(ledger_dir, id)
    if file_exists(path) == false {
        return null
    }
    if path_is_dir(path) {
        return {"error": "run path is a directory: " + path}
    }
    mut raw := ""
    try {
        raw = read_file(path)
    } except read_error {
        return {"error": "cannot read run file: " + path}
    }
    mut parsed := null
    try {
        parsed = parse_json(raw)
    } except parse_error {
        return {"error": "corrupt run file: " + path}
    }
    if type(parsed) == "Error" {
        return {"error": "corrupt run file: " + path}
    }
    if type(parsed) != "dict" {
        return {"error": "invalid run file shape: " + path}
    }
    rec := normalize_record(parsed)
    if rec["id"] != id {
        return {"error": "run id mismatch in file: " + path}
    }
    return rec
}

# Load every run in the ledger, sorted by id (which is chronological by date
# prefix). Skips unreadable files rather than failing the whole listing.
export func list_records(ledger_dir) {
    return inspect_records(ledger_dir)["records"]
}

# Inspect every receipt without hiding malformed/unreadable entries. The
# default listing keeps its historical skip-invalid behavior; strict callers
# can fail on these diagnostics rather than consuming an incomplete ledger.
export func inspect_records(ledger_dir) {
    rd := runs_dir(ledger_dir)
    mut out := []
    mut errors := []
    if file_exists(ledger_dir) && path_is_dir(ledger_dir) == false {
        return {"records": out, "errors": [{"file": ledger_dir, "error": "ledger path is not a directory: " + ledger_dir}]}
    }
    if path_is_dir(rd) == false {
        return {"records": out, "errors": errors}
    }
    mut entries := []
    try {
        entries = list_dir(rd)
    } except list_error {
        return {"records": out, "errors": [{"file": rd, "error": "cannot list runs directory: " + rd}]}
    }
    mut names := range(0, len(entries))
    mut name_count := 0
    mut e := 0
    while e < len(entries) {
        name := entries[e]
        if ends_with(name, ".json") {
            names[name_count] := name
            name_count = name_count + 1
        }
        e = e + 1
    }
    names = sort(slice(names, 0, name_count))
    out = range(0, len(names))
    errors = range(0, len(names))
    mut valid_count := 0
    mut error_count := 0
    mut k := 0
    while k < len(names) {
        name := names[k]
        id := substring(name, 0, len(name) - 5)
        rec := load(ledger_dir, id)
        if type(rec) == "dict" && truthy(has_key(rec, "id")) {
            out[valid_count] := rec
            valid_count = valid_count + 1
        } else {
            message := "missing run file: " + run_path(ledger_dir, id)
            if type(rec) == "dict" && has_key(rec, "error") == 1 {
                message = rec["error"]
            }
            errors[error_count] := {"file": name, "error": message}
            error_count = error_count + 1
        }
        k = k + 1
    }
    return {"records": slice(out, 0, valid_count), "errors": slice(errors, 0, error_count)}
}

func normalize_record(record) {
    mut rec := record
    rec = put_defaults(rec, [
        {"key": "id", "fallback": null},
        {"key": "created_at", "fallback": null},
        {"key": "updated_at", "fallback": null},
        {"key": "status", "fallback": "in_progress"},
        {"key": "provider", "fallback": null},
        {"key": "model", "fallback": null},
        {"key": "task_name", "fallback": null},
        {"key": "prompt_file", "fallback": null},
        {"key": "repo_path", "fallback": null},
        {"key": "start_commit", "fallback": null},
        {"key": "end_commit", "fallback": null},
        {"key": "git_dirty_start", "fallback": null},
        {"key": "git_dirty_end", "fallback": null},
        {"key": "changed_files", "fallback": []},
        {"key": "commands", "fallback": []},
        {"key": "tests", "fallback": []},
        {"key": "usage", "fallback": empty_usage()},
        {"key": "cost", "fallback": empty_cost()},
        {"key": "correlation", "fallback": empty_correlation()},
        {"key": "verdict", "fallback": null},
        {"key": "followups", "fallback": []},
        {"key": "notes", "fallback": []}
    ])
    rec = normalize_list_fields(rec, ["commands", "tests", "followups", "notes"])
    rec["changed_files"] := normalize_string_list(rec["changed_files"])
    rec["usage"] := normalize_usage(rec["usage"])
    rec["cost"] := normalize_cost(rec["cost"])
    rec["correlation"] := normalize_correlation(rec["correlation"])
    return rec
}

func normalize_correlation(value) {
    correlation_result := empty_correlation()
    if type(value) != "dict" { return correlation_result }
    for key in keys(correlation_result) {
        candidate := null
        if has_key(value, key) == 1 { candidate = value[key] }
        if type(candidate) == "string" && len(trim(candidate)) > 0 && len(candidate) <= 160 {
            safe := true
            mut i := 0
            while i < len(candidate) {
                ch := substring(candidate, i, i + 1)
                if index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_:.", ch) < 0 { safe = false }
                i = i + 1
            }
            if safe { correlation_result[key] := candidate }
        }
    }
    return correlation_result
}

func put_defaults(target, defaults) {
    mut out := target
    mut i := 0
    while i < len(defaults) {
        item := defaults[i]
        out = put_default(out, item["key"], item["fallback"])
        i = i + 1
    }
    return out
}

func put_default(target, key, fallback) {
    if has_key(target, key) == 0 {
        target[key] := fallback
    }
    return target
}

func normalize_list_fields(target, keys) {
    mut out := target
    mut i := 0
    while i < len(keys) {
        key := keys[i]
        out[key] := normalize_list(out[key])
        i = i + 1
    }
    return out
}

func normalize_list(value) {
    t := type(value)
    if t == "array" || t == "list" {
        return value
    }
    return []
}

func normalize_string_list(value) {
    items := normalize_list(value)
    mut out := []
    mut i := 0
    while i < len(items) {
        if type(items[i]) == "string" {
            out = push(out, items[i])
        }
        i = i + 1
    }
    return out
}

func normalize_usage(value) {
    fields := [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens"
    ]
    return copy_non_negative_int_fields(empty_usage(), value, fields)
}

func normalize_cost(value) {
    mut out := copy_non_negative_number_fields(empty_cost(), value, [
        "input_cost",
        "output_cost",
        "cache_cost",
        "total_cost"
    ])
    if type(value) == "dict" && has_key(value, "currency") == 1 {
        currency := value["currency"]
        if type(currency) == "string" && trim(currency) != "" {
            out["currency"] := currency
        }
    }
    return out
}

func copy_non_negative_int_fields(target, source, keys) {
    mut out := target
    if type(source) != "dict" {
        return out
    }
    mut i := 0
    while i < len(keys) {
        key := keys[i]
        if has_key(source, key) == 1 {
            value := source[key]
            if type(value) == "int" && value >= 0 {
                out[key] := value
            }
        }
        i = i + 1
    }
    return out
}

func copy_non_negative_number_fields(target, source, keys) {
    mut out := target
    if type(source) != "dict" {
        return out
    }
    mut i := 0
    while i < len(keys) {
        key := keys[i]
        if has_key(source, key) == 1 {
            value := source[key]
            if (type(value) == "int" || type(value) == "float") && value >= 0 {
                out[key] := value
            }
        }
        i = i + 1
    }
    return out
}
