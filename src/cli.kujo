# RunLedger :: cli
#
# Argument parsing and command dispatch. This is the only module that prints
# user-facing command output and chooses process exit codes. It wires together
# record / storage / gitmeta / render and keeps all I/O decisions in one place.
#
# Exit code convention:
#   0  success
#   1  operational failure (no such run, invalid status, corrupt file)
#   2  usage error (bad/missing arguments)

from src.record import new_record, is_valid_status, valid_statuses, empty_usage, empty_cost, empty_correlation
from src.storage import generate_id, save_new, load, inspect_records, inspect_records_window, run_path, write_atomic_text, update_record
from src.gitmeta import start_metadata, end_metadata
from src.render import render_list, render_show, render_compare, render_report
from src.args import parse_args

VERSION := "1.1.0"

# ---------------------------------------------------------------------------
# User-facing text
# ---------------------------------------------------------------------------

func usage(command) {
    usages := {
        "start": "usage: runledger start --model <m> --provider <p> --task <t> [--prompt <file>] [--repo <path>] [--ledger <dir>]",
        "finish": "usage: runledger finish <run-id> --status <pass|partial|fail|abandoned> --verdict \"text\" [--notes <text>] [--repo <path>] [--ledger <dir>]",
        "list": "usage: runledger list [--json] [--strict] [--limit N] [--offset N] [--ledger <dir>]",
        "verify": "usage: runledger verify [--json] [--ledger <dir>]",
        "show": "usage: runledger show <run-id> [--json] [--ledger <dir>]",
        "note": "usage: runledger note <run-id> \"note text\" [--ledger <dir>]",
        "note-short": "usage: runledger note <run-id> \"note text\"",
        "command": "usage: runledger command <run-id> \"command text\" [--ledger <dir>]",
        "test": "usage: runledger test <run-id> \"test name\" --status <pass|fail|skip> [--details <text>] [--ledger <dir>]",
        "followup": "usage: runledger followup <run-id> \"follow-up text\" [--ledger <dir>]",
        "followup-short": "usage: runledger followup <run-id> \"follow-up text\"",
        "usage": "usage: runledger usage <run-id> [--input N] [--output N] [--cache-read N] [--cache-write N] [--ledger <dir>]",
        "cost": "usage: runledger cost <run-id> [--total N] [--currency CODE] [--input N] [--output N] [--cache N] [--ledger <dir>]",
        "correlate": "usage: runledger correlate <run-id> [--watchdog-trace ID] [--watchdog-run ID] [--dispatch-run ID] [--relay-run ID] [--eval-run ID] [--ledger <dir>]",
        "compare": "usage: runledger compare [--task <name>] [--json] [--strict] [--limit N] [--offset N] [--ledger <dir>]",
        "report": "usage: runledger report [--task <name>] [--output <file>] [--strict] [--limit N] [--offset N] [--ledger <dir>]"
    }
    if has_key(usages, command) == 1 {
        return usages[command]
    }
    return usages["report"]
}

func usage_error(text) {
    print(text)
    return 2
}

func print_error(message) {
    print("error: " + message)
}

func print_lines(lines) {
    mut i := 0
    while i < len(lines) {
        print(lines[i])
        i = i + 1
    }
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

func flag(parsed, name) {
    if has_key(parsed["flags"], name) == 1 {
        return parsed["flags"][name]
    }
    return null
}

func flag_or(parsed, name, fallback) {
    v := flag(parsed, name)
    if type(v) == "null" {
        return fallback
    }
    return v
}

func has_flag(parsed, name) {
    return has_key(parsed["flags"], name) == 1
}

func includes_name(names, name) {
    mut i := 0
    while i < len(names) {
        if names[i] == name {
            return true
        }
        i = i + 1
    }
    return false
}

# Reject malformed parser input, flags outside a command's public surface, and
# surplus positionals instead of silently accepting typos or ambiguous input.
func validate_parsed(parsed, allowed_flags, max_positionals, command) {
    errors := parsed["errors"]
    if len(errors) > 0 {
        print_error(errors[0])
        print(usage(command))
        return false
    }
    for name in keys(parsed["flags"]) {
        if includes_name(allowed_flags, name) == false {
            print_error("unknown flag for " + command + ": --" + name)
            print(usage(command))
            return false
        }
    }
    if len(parsed["positionals"]) > max_positionals {
        print_error("too many arguments for " + command)
        print(usage(command))
        return false
    }
    return true
}

# Resolve the ledger directory: --ledger flag, else RUNLEDGER_DIR env, else
# the conventional ./.runledger in the current working directory.
func resolve_ledger(parsed) {
    f := flag(parsed, "ledger")
    if type(f) != "null" && trim(f) != "" {
        return f
    }
    if type(f) != "null" && trim(f) == "" {
        return null
    }
    return env_or("RUNLEDGER_DIR", ".runledger")
}

# Refresh a record's updated_at timestamp.
func touch(record) {
    record["updated_at"] := now_utc()
    return record
}

# Load a record or print an error + return null. `where` names the command for
# the message.
func require_record(ledger, id, where) {
    if type(id) == "null" || id == "" {
        print_error(where + " requires a <run-id>")
        return null
    }
    rec := load(ledger, id)
    if type(rec) == "null" {
        print_error("no such run: " + id)
        return null
    }
    if type(rec) == "dict" && has_key(rec, "error") == 1 {
        print_error(rec["error"])
        return null
    }
    return rec
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

func cmd_start(tokens) {
    parsed := parse_args(tokens, [])
    if validate_parsed(parsed, ["model", "provider", "task", "prompt", "repo", "ledger"], 0, "start") == false {
        return 2
    }
    ledger := resolve_ledger(parsed)
    if type(ledger) == "null" {
        return usage_error(usage("start"))
    }
    model := flag(parsed, "model")
    provider := flag(parsed, "provider")
    task := flag(parsed, "task")
    if type(model) == "null" || trim(model) == "" || type(provider) == "null" || trim(provider) == "" || type(task) == "null" || trim(task) == "" {
        return usage_error(usage("start"))
    }
    repo := flag_or(parsed, "repo", ".")
    if trim(repo) == "" {
        return usage_error(usage("start"))
    }
    prompt := flag(parsed, "prompt")
    if type(prompt) != "null" && trim(prompt) == "" {
        return usage_error(usage("start"))
    }

    meta := start_metadata(repo)
    mut id := ""
    mut rec := null
    mut res := {"error": "could not allocate a unique run id"}
    mut attempts := 0
    while attempts < 100 {
        id = generate_id(ledger, model, task)
        rec = new_record(id, provider, model, task, prompt, repo)
        rec["start_commit"] := meta["start_commit"]
        rec["git_dirty_start"] := meta["git_dirty_start"]
        res = save_new(ledger, rec)
        if has_key(res, "error") == 0 || has_key(res, "conflict") == 0 {
            break
        }
        attempts = attempts + 1
    }
    if has_key(res, "error") == 1 {
        print_error(res["error"])
        return 1
    }

    print_lines([
        "Started run: " + id,
        "  storage:      " + run_path(ledger, id),
        "  repo:         " + repo,
        "  start commit: " + start_commit_label(rec),
        "",
        "Next: runledger finish " + id + " --status <pass|partial|fail|abandoned> --verdict \"...\""
    ])
    return 0
}

func start_commit_label(rec) {
    c := rec["start_commit"]
    if type(c) == "null" {
        return "(no git)"
    }
    return c
}

func cmd_finish(tokens) {
    parsed := parse_args(tokens, [])
    if validate_parsed(parsed, ["status", "verdict", "notes", "repo", "ledger"], 1, "finish") == false {
        return 2
    }
    ledger := resolve_ledger(parsed)
    if type(ledger) == "null" {
        return usage_error(usage("finish"))
    }
    id := first_positional(parsed)
    if type(id) == "null" || id == "" {
        return usage_error(usage("finish"))
    }
    status := flag(parsed, "status")
    if type(status) == "null" || trim(status) == "" {
        return usage_error(usage("finish"))
    }
    if is_valid_status(status) == false {
        print_error("invalid status '" + status + "'. Allowed: " + join(valid_statuses(), ", "))
        return 1
    }
    if status == "in_progress" {
        print_error("finish requires a terminal status: pass, partial, fail, or abandoned")
        return 2
    }
    verdict := flag(parsed, "verdict")
    if type(verdict) == "null" || trim(verdict) == "" {
        return usage_error(usage("finish"))
    }
    notes := flag(parsed, "notes")
    if type(notes) != "null" && trim(notes) == "" {
        return usage_error(usage("finish"))
    }
    res := update_record(ledger, id, func(rec) {
        if rec["status"] != "in_progress" {
            return {"error": "run is already finished: " + id}
        }
        rec["status"] := status
        rec["verdict"] := verdict
        if type(notes) != "null" {
            rec["notes"] := push(rec["notes"], {"at": now_utc(), "text": notes})
        }
        repo := flag_or(parsed, "repo", rec["repo_path"])
        if type(repo) != "string" || trim(repo) == "" {
            return {"error": usage("finish"), "usage_error": true}
        }
        meta := end_metadata(repo, rec["start_commit"])
        rec["end_commit"] := meta["end_commit"]
        rec["git_dirty_end"] := meta["git_dirty_end"]
        rec["changed_files"] := meta["changed_files"]
        touch(rec)
        return {"record": rec}
    })
    if has_key(res, "error") == 1 {
        if has_key(res, "usage_error") == 1 {
            return usage_error(res["error"])
        }
        print_error(res["error"])
        return 1
    }
    rec := res["record"]
    print_lines([
        "Finished run: " + id,
        "  status:       " + "${rec["status"]}",
        "  end commit:   " + start_or_dash(rec["end_commit"]),
        "  changed files: " + to_string(len(rec["changed_files"]))
    ])
    return 0
}

func start_or_dash(v) {
    if type(v) == "null" {
        return "-"
    }
    return "${v}"
}

func cmd_list(tokens) {
    parsed := parse_args(tokens, ["json", "strict"])
    if validate_parsed(parsed, ["json", "strict", "limit", "offset", "ledger"], 0, "list") == false {
        return 2
    }
    ledger := resolve_ledger(parsed)
    if type(ledger) == "null" {
        return usage_error(usage("list"))
    }
    window := parse_window(parsed)
    if has_key(window, "error") == 1 { return usage_error(window["error"]) }
    inspection := inspect_for_command(ledger, parsed, window)
    if has_flag(parsed, "strict") && report_record_errors(inspection) { return 1 }
    recs := window_records(inspection, parsed, window)
    if has_flag(parsed, "json") {
        print(to_json_pretty(recs))
        return 0
    }
    print(render_list(recs))
    return 0
}

func parse_window(parsed) {
    offset := flag(parsed, "offset")
    limit := flag(parsed, "limit")
    mut start := 0
    mut count := -1
    if type(offset) != "null" {
        if is_non_negative_int(offset) == false || len(offset) > 9 {
            return {"error": "--offset must be a non-negative integer up to 999999999"}
        }
        start = parse_int(offset)
    }
    if type(limit) != "null" {
        if is_non_negative_int(limit) == false || len(limit) > 4 {
            return {"error": "--limit must be an integer from 1 through 1000"}
        }
        count = parse_int(limit)
        if count < 1 || count > 1000 {
            return {"error": "--limit must be an integer from 1 through 1000"}
        }
    }
    paged := type(offset) != "null" || type(limit) != "null"
    return {"offset": start, "limit": count, "paged": paged}
}

func inspect_for_command(ledger, parsed, window) {
    if has_flag(parsed, "strict") { return inspect_records(ledger) }
    return inspect_records_window(ledger, window["offset"], window["limit"])
}

func window_records(inspection, parsed, window) {
    records := inspection["records"]
    if has_flag(parsed, "strict") == false || window["paged"] == false { return records }
    start := window["offset"]
    if start > len(records) { start = len(records) }
    mut end := len(records)
    if window["limit"] >= 0 && start + window["limit"] < end { end = start + window["limit"] }
    return slice(records, start, end)
}

func report_record_errors(inspection) {
    errors := inspection["errors"]
    if len(errors) == 0 { return false }
    for item in errors { print_error(item["error"]) }
    return true
}

func cmd_verify(tokens) {
    parsed := parse_args(tokens, ["json"])
    if validate_parsed(parsed, ["json", "ledger"], 0, "verify") == false { return 2 }
    ledger := resolve_ledger(parsed)
    if type(ledger) == "null" { return usage_error(usage("verify")) }
    inspection := inspect_records(ledger)
    if has_flag(parsed, "json") {
        print(to_json_pretty({"valid": len(inspection["records"]), "errors": inspection["errors"]}))
    } else if len(inspection["errors"]) == 0 {
        print("Verified " + to_string(len(inspection["records"])) + " run(s): no invalid entries")
    } else {
        report_record_errors(inspection)
    }
    if len(inspection["errors"]) > 0 { return 1 }
    return 0
}

func cmd_show(tokens) {
    parsed := parse_args(tokens, ["json"])
    if validate_parsed(parsed, ["json", "ledger"], 1, "show") == false {
        return 2
    }
    ledger := resolve_ledger(parsed)
    if type(ledger) == "null" {
        return usage_error(usage("show"))
    }
    id := first_positional(parsed)
    if type(id) == "null" || id == "" {
        return usage_error(usage("show"))
    }
    rec := require_record(ledger, id, "show")
    if type(rec) == "null" {
        return 1
    }
    if has_flag(parsed, "json") {
        print(to_json_pretty(rec))
        return 0
    }
    print(render_show(rec))
    return 0
}

func cmd_note(tokens) {
    parsed := parse_args(tokens, [])
    if validate_parsed(parsed, ["ledger"], 2, "note") == false {
        return 2
    }
    ledger := resolve_ledger(parsed)
    if type(ledger) == "null" {
        return usage_error(usage("note"))
    }
    id := first_positional(parsed)
    if type(id) == "null" || id == "" {
        return usage_error(usage("note-short"))
    }
    text := second_positional(parsed)
    if type(text) == "null" || trim(text) == "" {
        return usage_error(usage("note-short"))
    }
    res := update_record(ledger, id, func(rec) {
        rec["notes"] := push(rec["notes"], {"at": now_utc(), "text": text})
        touch(rec)
        return {"record": rec}
    })
    if has_key(res, "error") == 1 {
        print_error(res["error"])
        return 1
    }
    print("Added note to " + id)
    return 0
}

func cmd_followup(tokens) {
    parsed := parse_args(tokens, [])
    if validate_parsed(parsed, ["ledger"], 2, "followup") == false {
        return 2
    }
    ledger := resolve_ledger(parsed)
    if type(ledger) == "null" {
        return usage_error(usage("followup"))
    }
    id := first_positional(parsed)
    if type(id) == "null" || id == "" {
        return usage_error(usage("followup-short"))
    }
    text := second_positional(parsed)
    if type(text) == "null" || trim(text) == "" {
        return usage_error(usage("followup-short"))
    }
    res := update_record(ledger, id, func(rec) {
        rec["followups"] := push(rec["followups"], {"at": now_utc(), "text": text})
        touch(rec)
        return {"record": rec}
    })
    if has_key(res, "error") == 1 {
        print_error(res["error"])
        return 1
    }
    print("Added follow-up to " + id)
    return 0
}

# Record what an operator ran without executing arbitrary text. Both receipt
# arrays are bounded to keep this convenience feature from growing forever.
func cmd_command(tokens) {
    parsed := parse_args(tokens, [])
    if validate_parsed(parsed, ["ledger"], 2, "command") == false { return 2 }
    ledger := resolve_ledger(parsed)
    id := first_positional(parsed)
    text := second_positional(parsed)
    if type(ledger) == "null" || type(id) == "null" || bounded_text(text, 2000) == false {
        return usage_error(usage("command"))
    }
    res := update_record(ledger, id, func(rec) {
        if len(rec["commands"]) >= 1000 { return {"error": "run already has 1000 recorded commands"} }
        rec["commands"] := push(rec["commands"], {"at": now_utc(), "text": text})
        touch(rec)
        return {"record": rec}
    })
    if has_key(res, "error") == 1 { print_error(res["error"]); return 1 }
    print("Recorded command for " + id)
    return 0
}

func bounded_text(value, maximum) {
    return type(value) == "string" && trim(value) != "" && len(value) <= maximum
}

func cmd_test(tokens) {
    parsed := parse_args(tokens, [])
    if validate_parsed(parsed, ["status", "details", "ledger"], 2, "test") == false { return 2 }
    ledger := resolve_ledger(parsed)
    id := first_positional(parsed)
    name := second_positional(parsed)
    status := flag(parsed, "status")
    details := flag(parsed, "details")
    if type(ledger) == "null" || type(id) == "null" || bounded_text(name, 200) == false ||
       (status != "pass" && status != "fail" && status != "skip") ||
       (type(details) != "null" && bounded_text(details, 2000) == false) {
        return usage_error(usage("test"))
    }
    res := update_record(ledger, id, func(rec) {
        if len(rec["tests"]) >= 1000 { return {"error": "run already has 1000 recorded tests"} }
        rec["tests"] := push(rec["tests"], {"at": now_utc(), "name": name, "status": status, "details": details})
        touch(rec)
        return {"record": rec}
    })
    if has_key(res, "error") == 1 { print_error(res["error"]); return 1 }
    print("Recorded test for " + id)
    return 0
}

func cmd_usage(tokens) {
    parsed := parse_args(tokens, [])
    if validate_parsed(parsed, ["input", "output", "cache-read", "cache-write", "ledger"], 1, "usage") == false {
        return 2
    }
    ledger := resolve_ledger(parsed)
    if type(ledger) == "null" {
        return usage_error(usage("usage"))
    }
    id := first_positional(parsed)
    if type(id) == "null" || id == "" {
        return usage_error(usage("usage"))
    }
    if has_any_flag(parsed, ["input", "output", "cache-read", "cache-write"]) == false {
        return usage_error(usage("usage"))
    }
    res := update_record(ledger, id, func(rec) {
        usage := rec["usage"]
        if type(usage) != "dict" {
            usage = empty_usage()
        }
        update := set_int_flags(usage, parsed, [
            {"key": "input_tokens", "flag": "input"},
            {"key": "output_tokens", "flag": "output"},
            {"key": "cache_read_tokens", "flag": "cache-read"},
            {"key": "cache_write_tokens", "flag": "cache-write"}
        ])
        if has_key(update, "error") == 1 {
            return {"error": update["error"], "usage_error": true}
        }
        rec["usage"] := update["value"]
        touch(rec)
        return {"record": rec}
    })
    if has_key(res, "error") == 1 {
        print_error(res["error"])
        if has_key(res, "usage_error") == 1 {
            return 2
        }
        return 1
    }
    print("Updated usage for " + id)
    return 0
}

func set_int_flags(target, parsed, specs) {
    mut acc := target
    mut i := 0
    while i < len(specs) {
        spec := specs[i]
        res := set_int_flag(acc, spec["key"], flag(parsed, spec["flag"]), spec["flag"])
        if has_key(res, "error") == 1 {
            return res
        }
        acc = res["value"]
        i = i + 1
    }
    return {"value": acc}
}

func has_any_flag(parsed, names) {
    mut i := 0
    while i < len(names) {
        if has_flag(parsed, names[i]) {
            return true
        }
        i = i + 1
    }
    return false
}

func set_int_flag(target, key, value, flag_name) {
    if type(value) == "null" {
        return {"value": target}
    }
    if is_non_negative_int(value) == false {
        return {"error": "--" + flag_name + " must be a non-negative integer"}
    }
    target[key] := parse_int(value)
    return {"value": target}
}

func cmd_cost(tokens) {
    parsed := parse_args(tokens, [])
    if validate_parsed(parsed, ["total", "currency", "input", "output", "cache", "ledger"], 1, "cost") == false {
        return 2
    }
    ledger := resolve_ledger(parsed)
    if type(ledger) == "null" {
        return usage_error(usage("cost"))
    }
    id := first_positional(parsed)
    if type(id) == "null" || id == "" {
        return usage_error(usage("cost"))
    }
    if has_any_flag(parsed, ["total", "currency", "input", "output", "cache"]) == false {
        return usage_error(usage("cost"))
    }
    currency := flag(parsed, "currency")
    if type(currency) != "null" && trim(currency) == "" {
        return usage_error(usage("cost"))
    }
    res := update_record(ledger, id, func(rec) {
        cost := rec["cost"]
        if type(cost) != "dict" {
            cost = empty_cost()
        }
        if type(currency) != "null" {
            cost["currency"] := currency
        }
        update := set_float_flags(cost, parsed, [
            {"key": "input_cost", "flag": "input"},
            {"key": "output_cost", "flag": "output"},
            {"key": "cache_cost", "flag": "cache"},
            {"key": "total_cost", "flag": "total"}
        ])
        if has_key(update, "error") == 1 {
            return {"error": update["error"], "usage_error": true}
        }
        rec["cost"] := update["value"]
        touch(rec)
        return {"record": rec}
    })
    if has_key(res, "error") == 1 {
        print_error(res["error"])
        if has_key(res, "usage_error") == 1 {
            return 2
        }
        return 1
    }
    print("Updated cost for " + id)
    return 0
}

func correlation_value_safe(value) {
    if type(value) != "string" || trim(value) == "" || len(value) > 160 { return false }
    mut i := 0
    while i < len(value) {
        ch := substring(value, i, i + 1)
        if index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_:.", ch) < 0 { return false }
        i = i + 1
    }
    return true
}

func cmd_correlate(tokens) {
    parsed := parse_args(tokens, [])
    names := ["watchdog-trace", "watchdog-run", "dispatch-run", "relay-run", "eval-run"]
    allowed := ["watchdog-trace", "watchdog-run", "dispatch-run", "relay-run", "eval-run", "ledger"]
    if validate_parsed(parsed, allowed, 1, "correlate") == false { return 2 }
    ledger := resolve_ledger(parsed)
    id := first_positional(parsed)
    if type(ledger) == "null" || type(id) == "null" || id == "" || has_any_flag(parsed, names) == false { return usage_error(usage("correlate")) }
    for name in names {
        value := flag(parsed, name)
        if type(value) != "null" && correlation_value_safe(value) == false {
            print_error("--" + name + " must be a 1-160 character correlation identifier")
            return 2
        }
    }
    result := update_record(ledger, id, func(rec) {
        correlation := rec["correlation"]
        if type(correlation) != "dict" { correlation = empty_correlation() }
        mappings := [["watchdog-trace", "watchdog_trace_id"], ["watchdog-run", "watchdog_run_id"], ["dispatch-run", "dispatch_run_id"], ["relay-run", "relay_run_id"], ["eval-run", "eval_run_id"]]
        for mapping in mappings {
            value := flag(parsed, mapping[0])
            if type(value) != "null" { correlation[mapping[1]] := value }
        }
        rec["correlation"] := correlation
        touch(rec)
        return {"record": rec}
    })
    if has_key(result, "error") == 1 { print_error(result["error"]); return 1 }
    print("Updated correlation for " + id)
    return 0
}

func set_float_flags(target, parsed, specs) {
    mut acc := target
    mut i := 0
    while i < len(specs) {
        spec := specs[i]
        res := set_float_flag(acc, spec["key"], flag(parsed, spec["flag"]), spec["flag"])
        if has_key(res, "error") == 1 {
            return res
        }
        acc = res["value"]
        i = i + 1
    }
    return {"value": acc}
}

func set_float_flag(target, key, value, flag_name) {
    if type(value) == "null" {
        return {"value": target}
    }
    if is_non_negative_float(value) == false {
        return {"error": "--" + flag_name + " must be a non-negative number"}
    }
    target[key] := parse_float(value)
    return {"value": target}
}

func is_non_negative_int(text) {
    if type(text) != "string" || text == "" {
        return false
    }
    mut i := 0
    while i < len(text) {
        if is_digit(substring(text, i, i + 1)) == false {
            return false
        }
        i = i + 1
    }
    return true
}

func is_non_negative_float(text) {
    if type(text) != "string" || text == "" {
        return false
    }
    mut dots := 0
    mut digits := 0
    mut i := 0
    while i < len(text) {
        ch := substring(text, i, i + 1)
        if ch == "." {
            dots = dots + 1
            if dots > 1 {
                return false
            }
        } else if is_digit(ch) {
            digits = digits + 1
        } else {
            return false
        }
        i = i + 1
    }
    return digits > 0
}

func is_digit(ch) {
    return contains("0123456789", ch) == 1
}

func cmd_compare(tokens) {
    parsed := parse_args(tokens, ["json", "strict"])
    if validate_parsed(parsed, ["task", "json", "strict", "limit", "offset", "ledger"], 0, "compare") == false {
        return 2
    }
    ledger := resolve_ledger(parsed)
    if type(ledger) == "null" {
        return usage_error(usage("compare"))
    }
    window := parse_window(parsed)
    if has_key(window, "error") == 1 { return usage_error(window["error"]) }
    inspection := inspect_for_command(ledger, parsed, window)
    if has_flag(parsed, "strict") && report_record_errors(inspection) { return 1 }
    recs := window_records(inspection, parsed, window)
    task := flag(parsed, "task")
    if type(task) != "null" && trim(task) == "" {
        return usage_error(usage("compare"))
    }
    if type(task) != "null" {
        recs = filter_by_task(recs, task)
    }
    if has_flag(parsed, "json") {
        print(to_json_pretty(recs))
        return 0
    }
    print(render_compare(recs))
    return 0
}

func filter_by_task(records, task) {
    mut out := []
    for r in records {
        if "${r["task_name"]}" == task {
            out = push(out, r)
        }
    }
    return out
}

func cmd_report(tokens) {
    parsed := parse_args(tokens, ["strict"])
    if validate_parsed(parsed, ["task", "output", "strict", "limit", "offset", "ledger"], 0, "report") == false {
        return 2
    }
    ledger := resolve_ledger(parsed)
    if type(ledger) == "null" {
        return usage_error(usage("report"))
    }
    window := parse_window(parsed)
    if has_key(window, "error") == 1 { return usage_error(window["error"]) }
    inspection := inspect_for_command(ledger, parsed, window)
    if has_flag(parsed, "strict") && report_record_errors(inspection) { return 1 }
    recs := window_records(inspection, parsed, window)
    task := flag(parsed, "task")
    if type(task) != "null" && trim(task) == "" {
        return usage_error(usage("report"))
    }
    if type(task) != "null" {
        recs = filter_by_task(recs, task)
    }
    md := render_report(recs)
    if window["paged"] {
        bound := "all remaining"
        if window["limit"] >= 0 { bound = to_string(window["limit"]) }
        md = replace_str(md, "# RunLedger Report\n", "# RunLedger Report\n\nPage: file offset " + to_string(window["offset"]) + ", limit " + bound + ". Summary counts refer to this page only.\n")
    }
    output := flag(parsed, "output")
    if type(output) != "null" && trim(output) == "" {
        return usage_error(usage("report"))
    }
    if type(output) != "null" && output != "" {
        write_res := write_atomic_text(output, md)
        if has_key(write_res, "error") == 1 {
            print_error(write_res["error"])
            return 1
        }
        print("Wrote report to " + output)
        return 0
    }
    print(md)
    return 0
}

func first_positional(parsed) {
    p := parsed["positionals"]
    if len(p) >= 1 {
        return p[0]
    }
    return null
}

func second_positional(parsed) {
    p := parsed["positionals"]
    if len(p) >= 2 {
        return p[1]
    }
    return null
}

# ---------------------------------------------------------------------------
# Help / dispatch
# ---------------------------------------------------------------------------

func print_help() {
    print_lines([
        "runledger " + VERSION + " — a local ledger for AI-agent build runs",
        "",
        "Usage: runledger <command> [arguments]",
        "",
        "Commands:",
        "  start      Begin a new run record",
        "             usage: runledger start --model <m> --provider <p> --task <t> [--prompt <file>] [--repo <path>]",
        "  finish     Finalize a run (status, verdict, end git state)",
        "             usage: runledger finish <run-id> --status <pass|partial|fail|abandoned> --verdict \"text\"",
        "  list       List recorded runs in a compact table",
        "             usage: runledger list [--json]",
        "  verify     Check every run file and report invalid entries",
        "             usage: runledger verify [--json]",
        "  show       Show one run (add --json for the raw record)",
        "             usage: runledger show <run-id> [--json]",
        "  note       Add a timestamped note to a run",
        "             usage: runledger note <run-id> \"note text\"",
        "  followup   Add a follow-up item to a run",
        "             usage: runledger followup <run-id> \"follow-up text\"",
        "  command    Record a command description (does not execute it)",
        "             usage: runledger command <run-id> \"command text\"",
        "  test       Record a manual test outcome",
        "             usage: runledger test <run-id> \"test name\" --status <pass|fail|skip>",
        "  usage      Record token usage for a run",
        "             usage: runledger usage <run-id> [--input N] [--output N] [--cache-read N] [--cache-write N]",
        "  cost       Record cost for a run",
        "             usage: runledger cost <run-id> [--total N] [--currency CODE] [--input N] [--output N] [--cache N]",
        "  correlate  Link this receipt to Watchdog, Dispatch, Relay, or Eval identifiers",
        "             usage: runledger correlate <run-id> [--watchdog-trace ID] [--watchdog-run ID] [--dispatch-run ID] [--relay-run ID] [--eval-run ID]",
        "  compare    Compare runs in the ledger",
        "             usage: runledger compare [--task <name>] [--json]",
        "  report     Generate a markdown report (--output <file> to save)",
        "             usage: runledger report [--task <name>] [--output <file>]",
        "  help       Show this help",
        "  version    Show version",
        "",
        "Global:",
        "  --ledger <dir>   Ledger location (default ./.runledger, or $RUNLEDGER_DIR)",
        "",
        "Run scripts via: kujo run runledger.kujo -- <command> [arguments]"
    ])
}

# Entry point. `argv` is the user argument list (args()).
export func main(argv) {
    if len(argv) == 0 {
        print_help()
        return 0
    }
    cmd := argv[0]
    rest := slice(argv, 1, len(argv))

    if cmd == "help" || cmd == "--help" || cmd == "-h" {
        print_help()
        return 0
    }
    if cmd == "version" || cmd == "--version" || cmd == "-V" {
        print("runledger " + VERSION)
        return 0
    }
    if cmd == "start" {
        return cmd_start(rest)
    }
    if cmd == "finish" {
        return cmd_finish(rest)
    }
    if cmd == "list" {
        return cmd_list(rest)
    }
    if cmd == "verify" {
        return cmd_verify(rest)
    }
    if cmd == "show" {
        return cmd_show(rest)
    }
    if cmd == "note" {
        return cmd_note(rest)
    }
    if cmd == "followup" {
        return cmd_followup(rest)
    }
    if cmd == "command" {
        return cmd_command(rest)
    }
    if cmd == "test" {
        return cmd_test(rest)
    }
    if cmd == "usage" {
        return cmd_usage(rest)
    }
    if cmd == "cost" {
        return cmd_cost(rest)
    }
    if cmd == "correlate" {
        return cmd_correlate(rest)
    }
    if cmd == "compare" {
        return cmd_compare(rest)
    }
    if cmd == "report" {
        return cmd_report(rest)
    }

    print_error("unknown command '" + cmd + "'")
    print("Run 'runledger help' for usage.")
    return 2
}
